<?php

  global $user;

  $result = db_fetch_array( "SELECT o.id, o.class, o.name
                               FROM objects o
                         INNER JOIN enciclopedia e ON e.object_id = o.id
                              WHERE o.class IN (0, 1, 2, 3, 4, 5, 8)
                           ORDER BY o.class, o.name" );

  $out = "cnt=".count( $result );
  $l=0;
  foreach( $result as $item ) {
    $out.= "&id$l=".$item['id']."&n$l=".$item['name'];
    switch( $item['class'] ) {
      case 0:
        $out.= "&c$l=0x330000";
        break;
      case 1:
        $out.= "&c$l=0x003300";
        break;
      case 2:
        $out.= "&c$l=0x333300";
        break;
      case 3:
        $out.= "&c$l=0x000033";
        break;
      case 4:
        $out.= "&c$l=0x330033";
        break;
      case 5:
        $out.= "&c$l=0x333333";
        break;
      case 8:
        $out.= "&c$l=0x000033";
        break;
      default:
        $out.= "&c$l=0xFF0000";
        break;
    }
    $l++;
  }

  printOut( $out );
