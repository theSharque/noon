<?php

  global $user;

  if( $user->place_type == 5 ) {

    $ship_id = $user->real_id;

    if( $user->real_type == 2 ) {
      $parent = db_fetch_row( "SELECT place_id, place_type FROM ships WHERE id=".$ship_id );
    } else {
      $parent = db_fetch_row( "SELECT place_id, place_type FROM fleets WHERE id=".$ship_id );
    }

    while( $parent['place_type'] == 2 ) {
      $parent = db_fetch_row( "SELECT id, fleet_id, place_id, place_type FROM ships WHERE id=".$parent['place_id'] );

      $ship_id = $parent['fleet_id'] ? $parent['fleet_id'] : $parent['id'];
    }

    $timer = db_fetch_row( "SELECT UNIX_TIMESTAMP(event_time) - UNIX_TIMESTAMP(NOW()) remain, timer, event_type, arg1, arg2
                              FROM space_events WHERE ship_id = ".$ship_id );

    if( !$timer || !isset( $timer['timer'] ) ) {
      $out = "err=1";
      printOut( $out );
      return;
    }

    $et = isset( $timer['event_type'] ) ? intval( $timer['event_type'] ) : 0;
    $st = 0;
    $sname = '';
    $ptype = 0;
    $pname = '';
    $star = null;

    if( $et == 4 || $et == 104 ) {
      if( isset( $timer['arg2'] ) ) {
        $star = db_fetch_row( "SELECT type, name FROM stars WHERE id = ".$timer['arg2'] );
      }
    } else if( $et == 5 || $et == 105 ) {
      if( isset( $timer['arg1'] ) && isset( $timer['arg2'] ) ) {
        $sname = $timer['arg1'].':'.$timer['arg2'];
      }
    } else {
      $star = db_fetch_row( "SELECT s.type, s.name FROM planets p INNER JOIN stars s ON s.id = p.star_id WHERE p.id = ".$user->place_id );
      if( !$star || !isset( $star['type'] ) ) {
        $star = db_fetch_row( "SELECT type, name FROM stars WHERE id = ".$user->place_id );
      }

      if( ( !$star || !isset( $star['type'] ) ) && ( $et == 3 || $et == 103 ) && isset( $timer['arg2'] ) ) {
        $star = db_fetch_row( "SELECT s.type, s.name FROM planets p INNER JOIN stars s ON s.id = p.star_id WHERE p.id = ".$timer['arg2'] );
      }
    }

    if( $star && isset( $star['type'] ) ) {
      $st = intval( $star['type'] );
      $sname = $star['name'];
    }

    if( $et == 0 || $et == 1 || $et == 6 || $et == 8 || $et == 100 || $et == 101 || $et == 3 || $et == 103 ) {
      $planet_id = 0;
      if( ( $et == 3 || $et == 103 ) && isset( $timer['arg2'] ) && intval( $timer['arg2'] ) > 0 ) {
        $planet_id = intval( $timer['arg2'] );
      } else if( isset( $timer['arg1'] ) && intval( $timer['arg1'] ) > 0 ) {
        $planet_id = intval( $timer['arg1'] );
      } else if( intval( $user->place_id ) > 0 ) {
        $planet_id = intval( $user->place_id );
      }
      if( $planet_id > 0 ) {
        $planet = db_fetch_row( "SELECT p.type, p.name, s.type stype, s.name sname
                                   FROM planets p
                             INNER JOIN stars s ON s.id = p.star_id
                                  WHERE p.id = ".$planet_id );
        if( $planet && isset( $planet['type'] ) ) {
          $ptype = intval( $planet['type'] );
          $pname = $planet['name'];
          if( !$st ) {
            $st = intval( $planet['stype'] );
          }
          if( $sname === '' ) {
            $sname = $planet['sname'];
          }
        }
      }
    }

    $out = "err=0&total=".$timer['timer']."&remain=".($timer['remain'])."&et=".$et."&st=".$st."&sname=".$sname."&ptype=".$ptype."&pname=".$pname;
  } else {
    $out = "err=1";
  }

  printOut( $out );
